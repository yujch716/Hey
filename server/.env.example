PORT=3000
# 웹 출처(HTTP·socket.io CORS). 쉼표로 여러 개.
#   localhost: 맥북 브라우저 / 10.0.2.2: 에뮬레이터 안 차량 앱 WebView / 맥북 IP: 같은 Wi-Fi의 폰·실차
CORS_ORIGIN=http://localhost:5173,http://10.0.2.2:5173,http://192.168.0.10:5173
# 공유 링크 앞부분. url = WEB_BASE_URL + /t/{token}
WEB_BASE_URL=http://localhost:5173
# 카카오모빌리티 길찾기 REST 키. 비워 두면 정류지를 직선으로 잇고 구간 시간을 추정한다(개발·테스트용)
KAKAO_REST_API_KEY=
